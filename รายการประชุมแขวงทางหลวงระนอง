  let it;
  if (editingId != null) {
    const old = items.find(x => x.id === editingId), log = (old && old.log ? old.log.slice() : []);
    const ch = old ? diffItem(old, base, uploaded) : [];
    if (ch.length) log.push({t:new Date().toISOString(), a:'edit', ch});
    it = {...base, id: editingId, log: log.slice(-60)};
    const idx = items.findIndex(x => x.id === editingId);
    if (idx >= 0) items[idx] = it; else items.push(it);
  } else { it = {...base, id: Date.now(), log:[{t:new Date().toISOString(), a:'create'}]}; items.push(it); }
  upsertPerson(pos, uploaded ? photo : '');
  remember(it);
  extras.forEach(name=>{ if(name && !hist.pos.includes(name)) hist.pos.unshift(name); });
  store(K_HIST,hist);
  store(K_ITEMS, items); store(K_HIST, hist);
  if (editingId == null) store(K_DRAFT, {});
  month = it.date.slice(0,7);
  if (LISTS.includes(page) && it.type !== page) { page = it.type; setHash(page); }
  dlg.close(); render();
});

