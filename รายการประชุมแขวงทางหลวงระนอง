  $('pPrint').disabled=!l.length;
};
$('pPrint').onclick=()=>print();
$('pReset').onclick=()=>{['pFrom','pTo','pPerson','pType','pStatus'].forEach(i=>$(i).value='');$('pResult').innerHTML='';$('pPrint').disabled=true};
/* สำรอง / กู้คืน */
const K_BK='meeting_lastbackup_v1';let pend=null;
function renderBackup(){const t=load(K_BK,null),d=t?Math.floor((Date.now()-new Date(t))/864e5):null;
  $('bkLast').innerHTML=t?`${fdt(t)} น.<small>${d?` (${d} วันที่แล้ว)`:' (วันนี้)'}</small>`:'ยังไม่เคยสำรองข้อมูล';
  $('bkWarn').hidden=!(t===null||d>7);
  $('bkStat').textContent=`${items.length} รายการประชุม · ${people.length} ผู้เข้าร่วม · ขนาดข้อมูล ≈ ${(JSON.stringify([items,hist,people]).length/1024).toFixed(0)} KB`}
$('bkDo').onclick=()=>{const n=new Date(),a=document.createElement('a'),data={app:'meeting-ranong',version:1,exportedAt:n.toISOString(),items,hist,people,trashItems};
  const stamp=`${iso(n)}_${String(n.getHours()).padStart(2,'0')}${String(n.getMinutes()).padStart(2,'0')}`;
  let blob,name;
  if($('bkFormat').value==='html'){
    const json=JSON.stringify(data).replace(/</g,'\\u003c').replace(/>/g,'\\u003e').replace(/&/g,'\\u0026');
    const html=`<!doctype html><html lang="th"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ไฟล์สำรองข้อมูลรายการประชุม</title><style>body{font-family:Arial,sans-serif;max-width:850px;margin:40px auto;padding:0 18px;line-height:1.65;color:#243044}h1{font-size:24px}section{background:#f3f6fa;border-radius:12px;padding:18px}small{color:#5b6575}</style></head><body><h1>ไฟล์สำรองข้อมูลรายการประชุม</h1><section><p><b>หน่วยงาน:</b> แขวงทางหลวงระนอง กรมทางหลวง</p><p><b>วันที่สำรอง:</b> ${esc(fdt(n.toISOString()))} น.</p><p><b>รายการประชุม:</b> ${items.length} รายการ</p><p><b>ผู้เข้าร่วม:</b> ${people.length} รายการ</p><small>ไฟล์นี้มีข้อมูลสำรองสำหรับนำกลับเข้าระบบรายการประชุม ห้ามแก้ไขเนื้อหาภายในไฟล์</small></section><script type="application/json" id="meeting-backup-data">${json}<\/script></body></html>`;
    blob=new Blob([html],{type:'text/html;charset=utf-8'});name=`meeting-backup-${stamp}.html`;
  }else{
    blob=new Blob([JSON.stringify(data)],{type:'application/json'});name=`meeting-backup-${stamp}.json`;
  }
  a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);store(K_BK,n.toISOString());renderBackup();toast('สำรองข้อมูลเรียบร้อย')};
$('bkPick').onclick=()=>$('bkFile').click();
$('bkFile').onchange=async e=>{const f=e.target.files[0];e.target.value='';if(!f)return;$('bkPrev').hidden=false;
  try{const raw=await f.text();let d;if(/\.html?$/i.test(f.name)){const doc=new DOMParser().parseFromString(raw,'text/html');const node=doc.getElementById('meeting-backup-data');if(!node)throw 0;d=JSON.parse(node.textContent||node.innerText||'')}else{d=JSON.parse(raw)}if(d.app!=='meeting-ranong'||!Array.isArray(d.items))throw 0;
    const ok=d.items.filter(i=>i&&i.id!=null&&typeof i.pos==='string'&&typeof i.topic==='string'&&/^\d{4}-\d{2}-\d{2}$/.test(i.date)&&typeof i.start==='string');
    pend={...d,items:ok};
    $('bkPrev').innerHTML=`<b>${esc(f.name)}</b><br>สำรองเมื่อ ${d.exportedAt?fdt(d.exportedAt)+' น.':'ไม่ทราบ'} · ${ok.length} รายการประชุม${ok.length<d.items.length?` (ข้าม ${d.items.length-ok.length} รายการที่ไม่สมบูรณ์)`:''} · ${(d.people||[]).length} ผู้เข้าร่วม`;$('bkGo').hidden=false;
  }catch(_){pend=null;$('bkPrev').textContent='ไฟล์ไม่ถูกต้อง: ต้องเป็นไฟล์ .json หรือ .HTML ที่สำรองจากระบบนี้';$('bkGo').hidden=true}};
$('bkGo').onclick=()=>pend&&ask('ยืนยันการกู้คืนข้อมูล','ข้อมูลปัจจุบันทั้งหมดจะถูกแทนที่ด้วยข้อมูลจากไฟล์สำรอง<br>แนะนำให้สำรองข้อมูลปัจจุบันก่อน','กู้คืนข้อมูล',()=>{
  items=pend.items;hist=pend.hist||{pos:[],topic:[],loc:[],photos:{}};if(!pend.hist)items.forEach(remember);if(Array.isArray(pend.people))people=pend.people;if(Array.isArray(pend.trashItems)){trashItems=pend.trashItems;store(K_TRASH,trashItems)}
  store(K_ITEMS,items);store(K_HIST,hist);store(K_PEOPLE,people);pend=null;$('bkPrev').hidden=$('bkGo').hidden=true;month=null;render();toast('กู้คืนข้อมูลเรียบร้อย')});
/* ภาษา (Google Translate) + ขนาดตัวอักษร */
const K_LANG='meeting_lang_v1',K_ZM='meeting_zoom_v1';
function gt(l){const c=document.querySelector('.goog-te-combo');if(!c)return false;c.value=l;c.dispatchEvent(new Event('change'));return true}
window.gtInit=()=>{new google.translate.TranslateElement({pageLanguage:'th',includedLanguages:'en,th',autoDisplay:false},'gtEl');
  const w=setInterval(()=>{if(gt(load(K_LANG,'th')))clearInterval(w)},300);setTimeout(()=>clearInterval(w),8000)};
function setLang(l){store(K_LANG,l);document.querySelectorAll('[data-lang]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.lang===l));
  if(!window.google&&l==='en'){if(!$('gtS')){const s=document.createElement('script');s.id='gtS';s.src='https://translate.google.com/translate_a/element.js?cb=gtInit';s.onerror=()=>toast('โหลด Google Translate ไม่ได้ (ต้องเชื่อมต่ออินเทอร์เน็ต)');document.head.append(s)}return}
  gt(l)}
$('langBox').onclick=e=>{const b=e.target.closest('[data-lang]');if(b)setLang(b.dataset.lang)};
function setZm(v){document.documentElement.style.setProperty('--zm',v/100);$('zm').value=v;store(K_ZM,v)}
$('zm').onchange=e=>setZm(+e.target.value);setZm(load(K_ZM,100));
syncSys();
if(load(K_LANG,'th')==='en')setLang('en');
setTimeout(showSoon,500);
applyTheme(document.documentElement.dataset.theme, false);
</script>
<!-- ===================== ADD-ON: สลับมุมมอง ลิสต์/การ์ด + แจ้งเตือนสำรองข้อมูลทุกวันศุกร์ ===================== -->
<style id="addon-view-backup">
/* ---------- ปุ่มสวิตช์สลับมุมมอง (ไอคอน) ---------- */
.vsw{display:inline-flex;align-items:center;height:48px;padding:4px;gap:2px;border:1px solid var(--line);border-radius:12px;background:var(--card);flex:none}
.vsw button{width:40px;height:38px;border:0;border-radius:9px;background:transparent;color:var(--muted);display:flex;align-items:center;justify-content:center;transition:background .15s,color .15s}
.vsw button:hover{color:var(--link);background:var(--hov)}
.vsw button[aria-pressed="true"]{background:var(--accent);color:#fff}
.vsw button:focus-visible{outline:3px solid var(--focus);outline-offset:1px}

/* ---------- มุมมองแบบการ์ด (แถวละ 4 การ์ด) ---------- */
.table.cards{background:transparent;border:0;border-radius:0;overflow:visible}
.table.cards .scroll{overflow:visible}
.table.cards .hrow{display:none}
.table.cards #list{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.table.cards #list>.grid.row{display:flex;flex-direction:column;align-items:stretch;gap:10px;min-width:0;min-height:0;padding:18px 16px 12px 24px;border:1px solid var(--line);border-radius:16px;overflow:hidden;box-shadow:0 2px 8px rgba(18,38,58,.06);transition:transform .15s,box-shadow .15s}
.table.cards #list>.grid.row:last-child{border-bottom:1px solid var(--line)}
.table.cards #list>.grid.row:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(18,38,58,.14)}
.table.cards #list>.grid.row::before{width:8px}
.table.cards #list>.grid.row>.tp{order:-1;font-size:16px;font-weight:600;line-height:1.45}
.table.cards #list>.grid.row>:is(:nth-child(3),:nth-child(4),:nth-child(5),:nth-child(6))::before{display:block;font-size:12px;font-weight:600;color:var(--muted);margin-bottom:2px}
.table.cards #list>.grid.row>:nth-child(3)::before{content:"วันที่เข้าร่วม"}
.table.cards #list>.grid.row>:nth-child(4)::before{content:"เวลา"}
.table.cards #list>.grid.row>:nth-child(5)::before{content:"สถานที่"}
.table.cards #list>.grid.row>:nth-child(6)::before{content:"วันที่ได้รับแจ้ง"}
.table.cards #list>.grid.row>.racts{margin-top:auto;padding-top:8px;border-top:1px dashed var(--line)}
.table.cards #list>:not(.row){grid-column:1/-1}
.table.cards .empty{background:var(--card);border:1px solid var(--line);border-radius:14px}
@media (max-width:1280px){.table.cards #list{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:980px){.table.cards #list{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:600px){.table.cards #list{grid-template-columns:1fr}}
@media print{.vsw{display:none!important}}

/* ---------- Pop-up เตือนสำรองข้อมูลวันศุกร์ ---------- */
#friBkDlg{width:min(460px,94vw)}
#friBkDlg .fb{padding:26px 26px 22px;display:grid;gap:12px;text-align:center}
#friBkDlg .fb-ic{width:68px;height:68px;margin:0 auto;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(232,185,62,.18);color:#B7791F}
#friBkDlg h3{margin:0;font-size:21px}
#friBkDlg p{margin:0;color:var(--muted);font-size:15px;line-height:1.7}
#friBkDlg .fb-last{background:var(--head);border-radius:10px;padding:10px 12px;font-size:14px;line-height:1.6}
#friBkDlg .fb-last b{color:var(--ink)}
#friBkDlg .fb-acts{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:4px}
#friBkDlg .fb-acts .btn,#friBkDlg .fb-acts .ghost{height:44px;padding:0 18px;font-size:15px}
#friBkDlg label.chk{justify-content:center;font-size:14px;color:var(--muted);font-weight:500}
</style>

<script id="addon-view-backup-js">
(function(){
  'use strict';
  var $id=function(i){return document.getElementById(i)};

  /* =========================================================
     1) ปุ่มสวิตช์สลับมุมมอง: ลิสต์ / การ์ด (ใช้ได้ทั้งหน้า ภายนอก และ ภายใน)
     ========================================================= */
  var K_VIEW='meeting_view_v1';
  var ICON_LIST='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13"/><circle cx="3.5" cy="6" r="1"/><circle cx="3.5" cy="12" r="1"/><circle cx="3.5" cy="18" r="1"/></svg>';
  var ICON_GRID='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="2"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2"/></svg>';

  function getView(){
    try{return JSON.parse(localStorage.getItem(K_VIEW))==='cards'?'cards':'list'}catch(e){return 'list'}
  }
  function setView(v,save){
    var tb=document.querySelector('#vList .table');
    if(tb) tb.classList.toggle('cards',v==='cards');
    var sw=$id('viewSwitch');
    if(sw) sw.querySelectorAll('button[data-view]').forEach(function(b){
      b.setAttribute('aria-pressed',String(b.dataset.view===v));
    });
    if(save){try{localStorage.setItem(K_VIEW,JSON.stringify(v))}catch(e){}}
  }
  function initSwitch(){
    var add=$id('add');
    if(!add||$id('viewSwitch')) return;
    var sw=document.createElement('div');
    sw.className='vsw notranslate';
    sw.id='viewSwitch';
    sw.setAttribute('role','group');
    sw.setAttribute('aria-label','รูปแบบการแสดงผล');
    sw.innerHTML=
      '<button type="button" data-view="list" aria-pressed="true" title="แสดงแบบรายการ" aria-label="แสดงแบบรายการ">'+ICON_LIST+'</button>'+
      '<button type="button" data-view="cards" aria-pressed="false" title="แสดงแบบการ์ด" aria-label="แสดงแบบการ์ด">'+ICON_GRID+'</button>';
    add.insertAdjacentElement('afterend',sw);   /* วางถัดจากปุ่ม + เพิ่มการประชุม */
    sw.addEventListener('click',function(e){
      var b=e.target.closest('button[data-view]');
      if(b) setView(b.dataset.view,true);
    });
    setView(getView(),false);
  }

  /* =========================================================
     2) Pop-up แจ้งเตือนสำรองข้อมูล ทุกวันศุกร์
        - ไม่แสดง ถ้าวันนี้สำรองข้อมูลไปแล้ว
        - เลือก "ไม่ต้องเตือนอีกในวันนี้" ได้
        - รอให้ Pop-up อื่น (เช่น แจ้งเตือนประชุมพรุ่งนี้) ปิดก่อนจึงแสดง
     ========================================================= */
  var K_BK='meeting_lastbackup_v1';      /* คีย์เดิมของระบบ (เวลาสำรองล่าสุด) */
  var K_FRI='meeting_fri_remind_v1';     /* คีย์ใหม่: วันที่กด "ไม่ต้องเตือนอีกในวันนี้" */
  var shownDay='';

  function pad(n){return String(n).padStart(2,'0')}
  function isoDay(d){return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())}
  function readLS(k){
    var r=localStorage.getItem(k);
    if(r==null) return null;
    try{return JSON.parse(r)}catch(e){return r}
  }
  function lastBackup(){
    var v=readLS(K_BK), d=v?new Date(v):null;
    return d&&!isNaN(d)?d:null;
  }
  function fmtTH(d){
    return d.toLocaleString('th-TH',{weekday:'long',day:'numeric',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit'})+' น.';
  }
  function shouldRemind(){
    var now=new Date();
    if(now.getDay()!==5) return false;                 /* 5 = วันศุกร์ */
    var today=isoDay(now), lb=lastBackup();
    if(lb&&isoDay(lb)===today) return false;           /* วันนี้สำรองแล้ว */
    if(readLS(K_FRI)===today) return false;            /* ผู้ใช้ปิดเตือนของวันนี้ */
    return true;
  }
  function goBackupPage(){
    var p=document.querySelector('#pages .pg[data-page="สำรองข้อมูล"]');
    if(p) p.click();
  }
  function buildDlg(){
    var dlg=$id('friBkDlg');
    if(dlg) return dlg;
    dlg=document.createElement('dialog');
    dlg.id='friBkDlg';
    dlg.className='evd';
    dlg.innerHTML=
      '<div class="fb">'+
        '<div class="fb-ic"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h11l3 3v15H5z"/><path d="M8 3v5h7V3M8 21v-7h8v7"/></svg></div>'+
        '<h3>วันศุกร์แล้ว! อย่าลืมสำรองข้อมูล</h3>'+
        '<p>ข้อมูลรายการประชุมถูกเก็บไว้ในเบราว์เซอร์เครื่องนี้เท่านั้น<br>ควรสำรองข้อมูลทุกสัปดาห์เพื่อป้องกันข้อมูลสูญหาย</p>'+
        '<div class="fb-last" id="friBkLast"></div>'+
        '<label class="chk"><input type="checkbox" id="friBkOff">ไม่ต้องเตือนอีกในวันนี้</label>'+
        '<div class="fb-acts">'+
          '<button type="button" class="ghost" id="friBkLater">ภายหลัง</button>'+
          '<button type="button" class="ghost" id="friBkGo">ไปหน้าสำรองข้อมูล</button>'+
          '<button type="button" class="btn" id="friBkNow">⬇ สำรองข้อมูลตอนนี้</button>'+
        '</div>'+
      '</div>';
    document.body.appendChild(dlg);

    $id('friBkLater').onclick=function(){
      if($id('friBkOff').checked){try{localStorage.setItem(K_FRI,JSON.stringify(isoDay(new Date())))}catch(e){}}
      dlg.close();
    };
    $id('friBkGo').onclick=function(){dlg.close();goBackupPage()};
    $id('friBkNow').onclick=function(){
      dlg.close();
      goBackupPage();
      setTimeout(function(){var b=$id('bkDo'); if(b) b.click()},200);
    };
    return dlg;
  }
  function openRemind(){
    if(!shouldRemind()) return;
    var today=isoDay(new Date());
    if(shownDay===today) return;                         /* แสดง 1 ครั้งต่อการเปิดหน้าเว็บต่อวัน */
    if(document.querySelector('dialog[open]')){setTimeout(openRemind,1500);return}
    var dlg=buildDlg(), lb=lastBackup(), box=$id('friBkLast');
    if(lb){
      var a=new Date(lb.getFullYear(),lb.getMonth(),lb.getDate());
      var n=new Date(); n=new Date(n.getFullYear(),n.getMonth(),n.getDate());
      var days=Math.round((n-a)/864e5);
      box.innerHTML='สำรองข้อมูลล่าสุด: <b>'+fmtTH(lb)+'</b><br>('+days+' วันที่แล้ว)';
    }else{
      box.innerHTML='<b>ยังไม่เคยสำรองข้อมูลในเครื่องนี้</b>';
    }
    $id('friBkOff').checked=false;
    dlg.showModal();
    shownDay=today;
  }

  /* ---------- เริ่มทำงาน ---------- */
  function start(){
    initSwitch();
    setTimeout(openRemind,1200);                 /* ตรวจหลังเปิดหน้า */
    setInterval(openRemind,30*60*1000);          /* ตรวจซ้ำทุก 30 นาที (กรณีเปิดหน้าค้างข้ามวัน) */
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',start);
  else start();
})();
</script>
