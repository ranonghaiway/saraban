/* ---------- ฟอร์ม: จำสิ่งที่เคยพิมพ์ ---------- */
const dlg = document.getElementById('dlg'), f = document.getElementById('f');
const TEXT_FIELDS = ['type','pos','topic','date','loc','notified','note','start_h','start_m','end_h','end_m','status'];
let editingId = null; // ไม่ว่าง = กำลังแก้ไขรายการเดิม

// ตัวเลือกเวลา 24 ชม. แบบเลื่อนเลือก (ชั่วโมง 00–23, นาทีทีละ 5) — เวลาสิ้นสุดมี "ไม่ระบุ"
(function fillTime(){
  const H = [...Array(24).keys()].map(n => String(n).padStart(2,'0'));
  const M = [...Array(12).keys()].map(n => String(n*5).padStart(2,'0'));
  const opts = (arr, ph, extra='') => `<option value="" disabled selected hidden>${ph}</option>${extra}` + arr.map(v => `<option>${v}</option>`).join('');
  f.elements.start_h.innerHTML = opts(H,'ชม.');
  f.elements.start_m.innerHTML = opts(M,'นาที');
  f.elements.end_h.innerHTML = opts(H,'ชม.','<option value="none">ไม่ระบุ</option>');
  f.elements.end_m.innerHTML = opts(M,'นาที');
})();
function syncEnd(){
  const none = f.elements.end_h.value === 'none';
  f.elements.end_m.disabled = none;
  if (none) f.elements.end_m.selectedIndex = 0;
}
function getExtraParticipants(){
  return [...document.querySelectorAll('#attendeeInputs input[name="attendee"]')].map(el=>el.value.trim()).filter(Boolean);
}
function setExtraParticipants(values){
  const box=document.getElementById('attendeeInputs'); box.innerHTML='';
  const vals=(Array.isArray(values)?values:[]).filter(v=>String(v||'').trim());
  (vals.length?vals:['']).forEach(v=>addAttendeeInput(v));
}
function addAttendeeInput(value=''){
  const box=document.getElementById('attendeeInputs'), row=document.createElement('div');
  row.style.cssText='display:flex;gap:8px;align-items:center';
  const input=document.createElement('input'); input.type='text'; input.name='attendee'; input.setAttribute('list','dl-pos');
  input.placeholder='พิมพ์หรือเลือกชื่อผู้เข้าร่วม'; input.value=value||''; input.autocomplete='off'; input.style.flex='1';
  const remove=document.createElement('button'); remove.type='button'; remove.className='ghost'; remove.textContent='ลบ';
  remove.style.cssText='height:44px;padding:0 12px'; remove.setAttribute('aria-label','ลบช่องผู้เข้าร่วม');
  remove.addEventListener('click',()=>{ row.remove(); if(!box.querySelector('input[name="attendee"]')) addAttendeeInput(''); saveDraft(); });
  row.append(input,remove); box.append(row);
  input.addEventListener('input',saveDraft); input.addEventListener('change',saveDraft);
}
function saveDraft(){ if (editingId != null) return; store(K_DRAFT, {...Object.fromEntries(TEXT_FIELDS.map(n => [n, f.elements[n].value])),participantsText:getExtraParticipants()}); }
function restoreDraft(){
  const d = load(K_DRAFT, {});
  TEXT_FIELDS.forEach(n => f.elements[n].value = d[n] || '');
  setExtraParticipants(Array.isArray(d.participantsText) ? d.participantsText : String(d.participantsText||'').split(/\r?\n/));
  f.elements.photo.value = ''; syncEnd(); hintFor(f.elements.pos.value);
}
function hintFor(pos){
  const el = document.getElementById('photoHint');
  if (!pos) el.textContent = 'เลือกตำแหน่งจากฐานข้อมูลผู้เข้าร่วม ระบบจะใช้รูปที่ตั้งไว้ให้อัตโนมัติ';
  else if (peoplePhoto(pos)) el.textContent = 'ใช้รูปจากฐานข้อมูลผู้เข้าร่วม (อัปโหลดใหม่เพื่อเปลี่ยน)';
  else if (personOf(pos)) el.textContent = 'ตำแหน่งนี้อยู่ในฐานข้อมูลแล้ว แต่ยังไม่มีรูป — อัปโหลดได้ที่นี่';
  else el.textContent = 'ตำแหน่งใหม่ — เมื่อบันทึก จะเพิ่มเข้าฐานข้อมูลผู้เข้าร่วมให้อัตโนมัติ';
}
function fillFrom(it){
  f.reset();
  ['pos','topic','date','loc','notified'].forEach(n => f.elements[n].value = it[n] || '');
  f.elements.note.value = it.note || ''; setExtraParticipants((it.participants||[]).filter(p=>p!==it.pos));
  f.elements.type.value = pageOf(it); f.elements.status.value = it.canceled ? 'cancel' : '';
  const [sh, sm] = (it.start || '').split(':');
  f.elements.start_h.value = sh || ''; f.elements.start_m.value = sm || '';
  if (it.end) { const [eh, em] = it.end.split(':'); f.elements.end_h.value = eh; f.elements.end_m.value = em; }
  else f.elements.end_h.value = 'none';
  f.elements.photo.value = ''; syncEnd(); hintFor(it.pos);
}
function openForm(it){
  people = load(K_PEOPLE, people); render();
  editingId = it ? it.id : null;
  document.getElementById('dtitle').textContent = it ? 'แก้ไขการประชุม' : 'เพิ่มการประชุม';
  document.getElementById('clear').textContent = it ? 'คืนค่าเดิม' : 'ล้างฟอร์ม';
  if (it) { fillFrom(it); showHist(it); } else { restoreDraft(); f.elements.type.value = LISTS.includes(page)?page:'ภายใน'; showHist(null); }
  dlg.showModal();
}
dlg.addEventListener('close', ()=>{ editingId = null; });
document.getElementById('add').addEventListener('click', ()=> openForm(null));
document.getElementById('addAttendee').addEventListener('click', ()=>{
  addAttendeeInput('');
  const all=document.querySelectorAll('#attendeeInputs input[name="attendee"]');
  if(all.length) all[all.length-1].focus();
  saveDraft();
});
document.getElementById('cancel').addEventListener('click', ()=> dlg.close());
document.getElementById('clear').addEventListener('click', ()=>{
  if (editingId != null) { const it = items.find(i => i.id === editingId); if (it) fillFrom(it); return; }
  f.reset(); setExtraParticipants(['']); f.elements.type.value = LISTS.includes(page)?page:'ภายใน'; syncEnd(); hintFor(''); store(K_DRAFT, {});
});
f.addEventListener('input', e=>{
  if (e.target.name === 'end_h') syncEnd();
  if (e.target.name === 'pos') hintFor(e.target.value);
  saveDraft();
});

f.addEventListener('submit', async e=>{
  e.preventDefault();
  const d = new FormData(f), pos = d.get('pos').trim();
  const extras=getExtraParticipants();
  const participants=[...new Set([pos,...extras])];
  let photo = peoplePhoto(pos);
  const file = d.get('photo'), uploaded = !!(file && file.size);
  if (file && file.size) {
    photo = await new Promise(res=>{
      const img = new Image(), url = URL.createObjectURL(file);
      img.onload = ()=>{ // ย่อรูปเป็น 160px เพื่อประหยัดพื้นที่เก็บข้อมูล
        const s = 160, c = document.createElement('canvas'); c.width = c.height = s;
        const m = Math.min(img.width, img.height);
        c.getContext('2d').drawImage(img,(img.width-m)/2,(img.height-m)/2,m,m,0,0,s,s);
        URL.revokeObjectURL(url); res(c.toDataURL('image/jpeg',.85));
      };
      img.onerror = ()=>res(photo); img.src = url;
    });
  }
  const eh = f.elements.end_h.value;
  const base = {type:d.get('type'),pos,participants,topic:d.get('topic').trim(),date:d.get('date'),
