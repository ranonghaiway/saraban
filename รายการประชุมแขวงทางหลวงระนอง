  if (!months.includes(month)) {
    const nowKey = now.toISOString().slice(0,7);
    month = months.includes(nowKey) ? nowKey : (months[0] || null);
  }
  const q = query.trim().toLowerCase(), searching = q.length > 0;
  document.getElementById('chips').innerHTML = months.map(m =>
    `<button class="chip" data-m="${m}" aria-pressed="${m===month && !searching}">${monthLabel(m)}</button>`).join('');

  const matches = i => [i.pos, ...(i.participants||[]), i.topic, i.loc, i.note || '', fmtDate(i.date), monthLabel(i.date.slice(0,7))].some(s => s.toLowerCase().includes(q));
  const shown = pageItems
    .filter(i => searching ? matches(i) : i.date.startsWith(month || ''))
    .sort((a,b)=> (a.date+a.start).localeCompare(b.date+b.start));
  document.getElementById('status').innerHTML = searching
    ? `ค้นหา “${esc(query.trim())}” จากทุกเดือนในหน้า${page} — พบ ${shown.length} รายการ` : '';

  document.getElementById('list').innerHTML = shown.length ? shown.map((it,i)=>{
    const wd = dateOf(it.date).getDay(), past = isPast(it, now), st = statusOf(it, now);
    const c = isDark() ? (past ? PAST_DARK : DAY_DARK[wd]) : (past ? PAST : DAY[wd]);
    return `
    <div class="grid row${past?' past':''}" style="--band:${c[0]};--tint:${c[1]}">
      <div class="${(it.participants||[it.pos]).length>1?'who-many':'who'}">${(it.participants||[it.pos]).map((p,pi)=>`<div class="who-one">${avatar({...it,pos:p,photo:peoplePhoto(p)||((p===it.pos)?it.photo:'')},pi)}<div class="ps">${esc(p)}</div></div>`).join('')}${(it.participants||[it.pos]).length>1?`<div class="who-cnt"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.6 2.7-6 6-6s6 2.4 6 6M16 5.5a3 3 0 010 5.5M18 14.5c1.8.7 3 2.6 3 5.5"/></svg>รวม ${(it.participants||[it.pos]).length} คน</div>`:''}</div>
      <div class="tp">${esc(it.topic)}${it.note ? `<div class="nc">${esc(it.note)}</div>` : ''} </div>
      <div><div class="dt">${fmtDate(it.date)}</div><div class="wd">วัน${DAYNAME[wd]}</div></div>
      <div class="tm">${timeText(it)}</div>
      <div class="lc">${esc(it.loc)}</div>
      <div class="nt">${fmtDate(it.notified)}</div>
      <div>${pill(st)}</div>
      <div class="racts">
        <button class="edit" data-edit="${it.id}" aria-label="แก้ไขการประชุม ${esc(it.pos)} ${esc(it.topic)}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h4L19 9l-4-4L4 16z"/><path d="M13.5 6.5l4 4"/></svg>
        </button>
        <button class="del" data-del="${it.id}" aria-label="ลบการประชุม ${esc(it.pos)} ${esc(it.topic)}">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>
        </button>
      </div>
    </div>`;}).join('') : '<div class="empty">ไม่พบรายการการประชุม</div>';

  // กล่องสรุปรายเดือน
  document.getElementById('sumgrid').innerHTML = months.map(m => {
    const list = pageItems.filter(i => i.date.startsWith(m));
    const cn = list.filter(i=>i.canceled).length, done = list.filter(i => !i.canceled && isPast(i, now)).length;
    return `<div class="box${m===month && !searching?' on':''}">
      <div class="m">${monthLabel(m)}</div>
      <div class="n">${list.length}<small>ครั้ง</small></div>
      <div class="s"><span><i style="background:#8A94A0"></i>เสร็จสิ้น ${done}</span><span><i style="background:var(--accent)"></i>รอประชุม ${list.length-done-cn}</span><span><i style="background:#DC2626"></i>ยกเลิก ${cn}</span></div>
    </div>`;
  }).join('');

  fillLists();
}
function fillLists(){
  const lists = {pos:[...new Set([...people.map(p=>p.pos).sort((a,b)=>a.localeCompare(b,'th')), ...hist.pos])], topic:hist.topic, loc:hist.loc};
  [['pos','dl-pos'],['topic','dl-topic'],['loc','dl-loc']].forEach(([k,id])=>{
    document.getElementById(id).innerHTML = lists[k].map(v=>`<option value="${esc(v)}">`).join('');
