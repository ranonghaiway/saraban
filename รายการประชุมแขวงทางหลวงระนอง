let query = '', month = null;
const PAGES = ['ภายนอก','ภายใน','ปฏิทิน','พิมพ์รายงาน','สำรองข้อมูล'];
const PAGE_DESC = {'ภายนอก':'ประชุมออนไลน์ | จังหวัด | อื่นๆ','ภายใน':'ห้องประชุมภายใน'};
const pageOf = it => it.type === 'ภายนอก' ? 'ภายนอก' : 'ภายใน';   // รายการเก่าที่ยังไม่มีประเภท = ภายใน
function readHash(){ try { const h = decodeURIComponent(location.hash.slice(1)); return PAGES.includes(h) ? h : null; } catch(e){ return null; } }
function setHash(p){ try { history.replaceState(null, '', '#' + encodeURIComponent(p)); } catch(e){ location.hash = '#' + encodeURIComponent(p); } }
let page = readHash() || 'ภายใน';
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const dateOf = iso => new Date(iso + 'T00:00:00');
const fmtDate = iso => dateOf(iso).toLocaleDateString('th-TH',{day:'numeric',month:'short',year:'numeric'});
const monthLabel = key => dateOf(key + '-01').toLocaleDateString('th-TH',{month:'long',year:'numeric'});
const isPast = (it, now) => new Date(it.date + 'T' + (it.end || it.start || '00:00')) < now;
const timeText = it => it.end ? `${esc(it.start)}–${esc(it.end)} น.` : `${esc(it.start)} น. – ไม่ระบุ`;

function avatar(it, i){
  const ph = peoplePhoto(it.pos) || it.photo;
  if (ph) return `<div class="av"><img src="${esc(ph)}" alt=""></div>`;
  const pal = i%2 ? ['#F2D3BF','#9A4A1A'] : ['#BFD3E6','#1F4E79'];
  return `<div class="av" style="background:${pal[0]}"><svg width="44" height="44" viewBox="0 0 44 44" aria-hidden="true"><circle cx="22" cy="17" r="8" fill="${pal[1]}"/><path d="M5 44c0-11 7-17 17-17s17 6 17 17z" fill="${pal[1]}"/></svg></div>`;
}

